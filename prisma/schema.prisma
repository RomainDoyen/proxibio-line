// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  PRODUCER
  ADMIN
}

enum ContributionStatus {
  APPROVED
  PENDING
  REJECTED
}

model Producteur {
  id                 Int                  @id @default(autoincrement())
  name               String
  nameEnterprise     String
  address            String
  status             ContributionStatus   @default(APPROVED)
  profileImageUrl    String?              @db.Text
  description        String?              @db.Text
  tags               String[]             @default([])
  sellsCategories    String[]             @default([])
  phone              String?
  contactEmail       String?
  website            String?
  instagram          String?
  facebook           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdByUserId    String?
  ownerUserId        String?
  createdBy          User?                @relation("ProducteurCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  owner              User?                @relation("ProducteurOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  positionProducteur positionProducteur[]
}

model positionProducteur {
  id           Int        @id @default(autoincrement())
  producteurId Int
  latitude     Float
  longitude    Float
  marker       String
  producteur   Producteur @relation(fields: [producteurId], references: [id], onDelete: Cascade)
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  passwordHash       String
  role               Role        @default(USER)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  producteursCreated Producteur[] @relation("ProducteurCreatedBy")
  producteursOwned   Producteur[] @relation("ProducteurOwner")
}
