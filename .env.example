# Neon PostgreSQL (Prisma + API locale)
# URL « pooled » (-pooler) pour l’app ; URL « direct » (sans -pooler) pour prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

API_PORT=3001
# Sur Railway / Render, la plateforme définit PORT — l’API l’utilise automatiquement (plus besoin d’API_PORT).

# Secret pour signer les JWT de session (génère une chaîne longue aléatoire en prod)
JWT_SECRET="change-moi-vers-une-valeur-secrete-longue"

# Emails (minuscules) qui reçoivent le rôle ADMIN à l’inscription — séparés par des virgules
# Les comptes déjà créés : passer en ADMIN via /admin (par un autre admin) ou Prisma Studio
# ADMIN_BOOTSTRAP_EMAILS="toi@example.com"

# --- Front déployé ailleurs que l’API (ex. Vercel + Railway) ---
# Build Vite / Vercel : URL publique de l’API (sans slash final). En local, ne pas définir (proxy).
# VITE_API_URL="https://ton-api.example.com"

# API Express : origines autorisées CORS (cookies), séparées par des virgules
# CORS_ORIGIN="https://ton-site.vercel.app,http://localhost:5173"

# API Express : obligatoire si front et API sont sur des domaines différents (cookies de session)
# CROSS_ORIGIN_COOKIES=true
